# Copy this file to .env.local and adjust if your API is not on the default port.
#
#   cp .env.example .env.local

# Where scm-backend is listening. Public because the browser makes the
# mutations itself — TanStack Query runs them client-side — so the value has to
# be in the bundle, not just on the server.
#
# It must match one of the origins in the backend's CORS_ORIGINS, and the
# backend must not be on the same port as this app (Next dev takes 3000).
NEXT_PUBLIC_API_URL=http://localhost:4000
